{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "SrmReadWrite",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:ListBucket",
                "s3:GetBucketLocation"
            ],
            "Resource": [
                "arn:aws:s3:::carbonplan-srm",
                "arn:aws:s3:::carbonplan-srm/*"
            ]
        },
        {
            "Sid": "PublishedReadOnly",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::us-west-2.opendata.source.coop",
                "arn:aws:s3:::us-west-2.opendata.source.coop/*"
            ]
        }
    ]
}
